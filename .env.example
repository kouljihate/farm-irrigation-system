# Flask Configuration
SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# Logging
LOG_LEVEL=INFO

# MongoDB (optional - can also be set in config.yaml)
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DB=farm_irrigation
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_AUTH_SRC=admin

# MapHub
# Keep this secret server-side; never put it in JavaScript/templates.
MAPHUB_API_KEY=
MAPHUB_BASE_URL=https://maphub.net
MAPHUB_EMBED_BASE_URL=https://maphub.net/embed
MAPHUB_VISIBILITY=unlisted
MAPHUB_TIMEOUT_SECONDS=20
